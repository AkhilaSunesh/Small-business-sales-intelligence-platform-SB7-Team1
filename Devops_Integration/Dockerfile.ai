FROM python:3.10-slim

# Set working directory
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends wget && rm -rf /var/lib/apt/lists/*

COPY Devops_Integration/ai_requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY Devops_Integration/ai_service.py ./ai_service.py

ENV PORT=5001

# Expose port
EXPOSE 5001

# Command to run FastAPI server
CMD ["sh", "-c", "uvicorn ai_service:app --host 0.0.0.0 --port ${PORT:-5001}"]
