# Stage 1: Build the React application
# Use Debian-based Node (not Alpine) — Tailwind CSS v4's @tailwindcss/oxide
# native Rust binary has no prebuilt for Alpine musl libc.
FROM node:20-slim AS builder

WORKDIR /app

COPY ./Frontend/package*.json ./
RUN npm install
COPY ./Frontend/ ./

# Build application
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:1.25-alpine

# Copy built files to Nginx public folder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration to listen on port 3000
COPY Devops_Integration/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 3000
EXPOSE 3000

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
