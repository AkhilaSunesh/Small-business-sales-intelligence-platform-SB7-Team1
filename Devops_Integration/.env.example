# PostgreSQL Settings
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=your_postgres_db_name_here

# Prisma Connection URL (used by backend)
# Example placeholder for developers; do NOT commit real credentials
DATABASE_URL=your_database_url_here

# Local database URL for testing outside docker (if needed)
# DATABASE_URL=your_local_database_url_here

# Authentication
JWT_SECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Port Mappings
BACKEND_PORT=5000
FRONTEND_PORT=3000
AI_SERVICE_PORT=5001
POSTGRES_PORT=5432
SECURITY_GATEWAY_PORT=6000

# Service URLs
BACKEND_URL=http://localhost:5000
AI_SERVICE_URL=http://localhost:5001
SECURITY_GATEWAY_URL=http://localhost:6000
VITE_API_BASE_URL=http://localhost:5000
# End of example placeholders
