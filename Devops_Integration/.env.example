# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marketmind_db

# Prisma Connection URL (used by backend)
# In docker-compose, the database host is 'postgres'
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/marketmind_db?schema=public

# Local database URL for testing outside docker (if needed)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketmind_db?schema=public

# Authentication
JWT_SECRET=supersecretjwtkey123!

# Port Mappings
BACKEND_PORT=5000
FRONTEND_PORT=3000
AI_SERVICE_PORT=5001
POSTGRES_PORT=5432

# Service URLs
BACKEND_URL=http://localhost:5000
AI_SERVICE_URL=http://localhost:5001
