{
  "openapi": "3.0.3",
  "info": {
    "title": "MarketMind AI — Backend Database API",
    "version": "1.0.0",
    "description": "Internal backend service. All routes require a Bearer JWT issued by the Security API Gateway."
  },
  "servers": [
    { "url": "http://localhost:5000", "description": "Local backend (port 5000)" }
  ],
  "tags": [
    { "name": "Sales",     "description": "Sales transactions and CSV upload" },
    { "name": "Inventory", "description": "Stock management" },
    { "name": "Dashboard", "description": "KPI summary" },
    { "name": "Analytics", "description": "Revenue and top-product analytics" },
    { "name": "Products",  "description": "Product catalogue (read-only)" },
    { "name": "Customers", "description": "Customer list (read-only)" },
    { "name": "Invoices",  "description": "Invoice management — create, view, pay, revenue summary" },
    { "name": "Forecast",  "description": "Sales forecast based on historical transaction data" }
  ],
  "paths": {
    "/api/sales": {
      "get": {
        "tags": ["Sales"],
        "summary": "List sales transactions (paginated)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page",        "in": "query", "schema": { "type": "integer", "default": 1,  "minimum": 1 } },
          { "name": "pageSize",    "in": "query", "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 } },
          { "name": "customerId",  "in": "query", "schema": { "type": "string" } },
          { "name": "productId",   "in": "query", "schema": { "type": "string" } },
          { "name": "startDate",   "in": "query", "schema": { "type": "string", "format": "date", "example": "2024-01-01" } },
          { "name": "endDate",     "in": "query", "schema": { "type": "string", "format": "date", "example": "2024-12-31" } }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of sales with customer/product/user details",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SalesListResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/sales/{id}": {
      "get": {
        "tags": ["Sales"],
        "summary": "Get a single sale by ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Single sale transaction" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/sales/upload": {
      "post": {
        "tags": ["Sales"],
        "summary": "Upload a CSV file of sales rows",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "CSV file. Required columns: CustomerID, ProductID, Quantity, Price, TransactionDate"
                  }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload summary",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UploadSummaryResponse" }
              }
            }
          },
          "400": { "description": "No file, wrong format, or missing columns" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/inventory": {
      "get": {
        "tags": ["Inventory"],
        "summary": "List all inventory with low-stock flags",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Inventory list annotated with lowStock boolean and summary counts",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InventoryListResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/inventory/low-stock": {
      "get": {
        "tags": ["Inventory"],
        "summary": "List only items at or below their low-stock threshold",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Low-stock items with count summary" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/inventory/add": {
      "post": {
        "tags": ["Inventory"],
        "summary": "Increment stock quantity for a product",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InventoryWriteRequest" } } }
        },
        "responses": {
          "200": { "description": "Updated inventory record" },
          "400": { "description": "Validation failed" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/inventory/update": {
      "put": {
        "tags": ["Inventory"],
        "summary": "Set absolute stock level for a product",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InventoryWriteRequest" } } }
        },
        "responses": {
          "200": { "description": "Updated inventory record" },
          "400": { "description": "Validation failed" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/inventory/delete": {
      "delete": {
        "tags": ["Inventory"],
        "summary": "Delete inventory record for a product",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "productCode": { "type": "string", "example": "PROD-0001" } },
                "required": ["productCode"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Inventory record deleted" },
          "400": { "description": "Validation failed" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/dashboard/summary": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "KPI summary — total customers, products, sales and revenue",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Dashboard KPI object",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardSummaryResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/analytics/summary": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Analytics — total revenue, sales count, top 5 products by quantity sold",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Analytics summary",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnalyticsSummaryResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": ["Products"],
        "summary": "List all products ordered by id",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Array of products",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductListResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/customers": {
      "get": {
        "tags": ["Customers"],
        "summary": "List customers (up to 100, alphabetical by name)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Array of customers",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerListResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },

    "/api/invoices": {
      "get": {
        "tags": ["Invoices"],
        "summary": "List invoices with pagination, search and filters",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page",           "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "pageSize",       "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } },
          { "name": "sortBy",         "in": "query", "schema": { "type": "string", "enum": ["createdAt","dueDate","totalAmount","status","invoiceNumber"], "default": "createdAt" } },
          { "name": "sortOrder",      "in": "query", "schema": { "type": "string", "enum": ["asc","desc"], "default": "desc" } },
          { "name": "status",         "in": "query", "schema": { "type": "string", "enum": ["PAID","UNPAID","PARTIALLY_PAID","OVERDUE","CANCELLED"] } },
          { "name": "search",         "in": "query", "schema": { "type": "string" }, "description": "Search invoice number or customer name" },
          { "name": "customerSearch", "in": "query", "schema": { "type": "string" }, "description": "Filter by customer name or code" },
          { "name": "invoiceSearch",  "in": "query", "schema": { "type": "string" }, "description": "Filter by invoice number" },
          { "name": "dateFrom",       "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "dateTo",         "in": "query", "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "200": { "description": "Paginated invoice list with pagination meta", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvoiceListResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "tags": ["Invoices"],
        "summary": "Create a manual invoice",
        "description": "Creates an invoice with line items. Automatically deducts inventory and calculates subtotal, 18% GST, discount and total. Due date defaults to 30 days from now.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateInvoiceRequest" } } }
        },
        "responses": {
          "201": { "description": "Invoice created successfully", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvoiceResponse" } } } },
          "400": { "description": "Validation failed or insufficient stock" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },

    "/api/invoices/revenue/summary": {
      "get": {
        "tags": ["Invoices"],
        "summary": "Revenue summary — total collected, outstanding, today's collections",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Revenue summary object", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevenueSummaryResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },

    "/api/invoices/status/{status}": {
      "get": {
        "tags": ["Invoices"],
        "summary": "List invoices filtered by payment status",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "path", "required": true, "schema": { "type": "string", "enum": ["paid","unpaid","partially_paid","overdue","cancelled"] }, "description": "Case-insensitive status value" },
          { "name": "page",     "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Paginated list of invoices matching the given status" },
          "400": { "description": "Invalid status value" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },

    "/api/invoices/overdue/check": {
      "post": {
        "tags": ["Invoices"],
        "summary": "Mark past-due unpaid/partially-paid invoices as OVERDUE",
        "description": "Scans all UNPAID and PARTIALLY_PAID invoices whose dueDate is in the past and updates their status to OVERDUE.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Count of invoices updated", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "message": { "type": "string" }, "data": { "type": "object", "properties": { "updatedCount": { "type": "integer" } } } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },

    "/api/invoices/{id}": {
      "get": {
        "tags": ["Invoices"],
        "summary": "Get a single invoice by UUID",
        "description": "Returns full invoice detail including customer, linked sales transaction, line items, payments and audit fields.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Full invoice object", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvoiceResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },

    "/api/invoices/{id}/payments": {
      "post": {
        "tags": ["Invoices"],
        "summary": "Record a payment against an invoice",
        "description": "Adds a payment record and automatically updates invoice status to PAID, PARTIALLY_PAID, or leaves as UNPAID based on cumulative amount paid.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "Invoice UUID" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordPaymentRequest" } } }
        },
        "responses": {
          "201": { "description": "Payment recorded; invoice status updated" },
          "400": { "description": "Invalid amount or invoice is cancelled" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },

    "/api/forecast": {
      "get": {
        "tags": ["Forecast"],
        "summary": "Generate a sales forecast from historical transaction data",
        "description": "Uses a 7-day simple moving average (SMA) over historical SalesTransaction records to project future daily revenue and transaction counts. No external ML library is required.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "schema": { "type": "integer", "default": 30, "minimum": 1, "maximum": 365 },
            "description": "Number of future days to forecast (default 30)"
          },
          {
            "name": "lookback",
            "in": "query",
            "schema": { "type": "integer", "default": 90, "minimum": 7, "maximum": 365 },
            "description": "Historical days to base the SMA on (default 90)"
          },
          {
            "name": "window",
            "in": "query",
            "schema": { "type": "integer", "default": 7, "minimum": 2, "maximum": 30 },
            "description": "SMA window size in days (default 7)"
          }
        ],
        "responses": {
          "200": {
            "description": "Forecast data with historical series",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ForecastResponse" }
              }
            }
          },
          "400": { "description": "Invalid query parameter value" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT issued by the Security API Gateway. Include as: Authorization: Bearer <token>"
      }
    },
    "responses": {
      "Unauthorized": { "description": "Missing or invalid JWT" },
      "NotFound":      { "description": "Resource not found" },
      "ServerError":   { "description": "Internal server error" }
    },
    "schemas": {
      "InventoryWriteRequest": {
        "type": "object",
        "properties": {
          "productCode": { "type": "string", "example": "PROD-0001" },
          "quantity":    { "type": "integer", "minimum": 0, "example": 25 }
        },
        "required": ["productCode", "quantity"]
      },
      "UploadSummaryResponse": {
        "type": "object",
        "properties": {
          "success":    { "type": "boolean" },
          "message":    { "type": "string" },
          "summary": {
            "type": "object",
            "properties": {
              "filename":          { "type": "string" },
              "uploadedAt":        { "type": "string", "format": "date-time" },
              "totalRowsRead":     { "type": "integer" },
              "recordsInserted":   { "type": "integer" },
              "duplicatesRemoved": { "type": "integer" },
              "invalidRows":       { "type": "integer" },
              "validationErrors":  {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "row":    { "type": "integer" },
                    "reason": { "type": "string" },
                    "data":   { "type": "object" }
                  }
                }
              }
            }
          }
        }
      },
      "InventoryListResponse": {
        "type": "object",
        "properties": {
          "success":   { "type": "boolean" },
          "inventory": { "type": "array", "items": { "type": "object" } },
          "summary": {
            "type": "object",
            "properties": {
              "total":         { "type": "integer" },
              "lowStockCount": { "type": "integer" }
            }
          }
        }
      },
      "SalesListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data":    { "type": "array", "items": { "type": "object" } },
          "pagination": {
            "type": "object",
            "properties": {
              "total":      { "type": "integer" },
              "page":       { "type": "integer" },
              "pageSize":   { "type": "integer" },
              "totalPages": { "type": "integer" }
            }
          }
        }
      },
      "DashboardSummaryResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {
            "type": "object",
            "properties": {
              "totalCustomers": { "type": "integer" },
              "totalProducts":  { "type": "integer" },
              "totalSales":     { "type": "integer" },
              "totalRevenue":   { "type": "number" }
            }
          }
        }
      },
      "AnalyticsSummaryResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {
            "type": "object",
            "properties": {
              "totalSales":   { "type": "integer" },
              "totalRevenue": { "type": "number" },
              "topProducts":  { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      },
      "ProductListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data":    { "type": "array", "items": { "type": "object" } }
        }
      },
      "CustomerListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data":    { "type": "array", "items": { "type": "object" } }
        }
      },

      "LineItemRequest": {
        "type": "object",
        "required": ["productId", "quantity", "unitPrice"],
        "properties": {
          "productId":   { "type": "string", "format": "uuid" },
          "productName": { "type": "string" },
          "quantity":    { "type": "integer", "minimum": 1 },
          "unitPrice":   { "type": "number",  "minimum": 0.01 }
        }
      },

      "CreateInvoiceRequest": {
        "type": "object",
        "required": ["customerId", "lineItems"],
        "properties": {
          "customerId":         { "type": "string", "format": "uuid" },
          "salesTransactionId": { "type": "string", "format": "uuid" },
          "lineItems":          { "type": "array", "items": { "$ref": "#/components/schemas/LineItemRequest" }, "minItems": 1 },
          "discountRate":       { "type": "number", "minimum": 0, "maximum": 100, "default": 0, "description": "Discount percentage e.g. 10 for 10%" },
          "taxRate":            { "type": "number", "minimum": 0, "maximum": 100, "default": 18, "description": "Tax rate percentage — defaults to 18% GST" },
          "dueDate":            { "type": "string", "format": "date-time", "description": "ISO date; defaults to 30 days from now" },
          "notes":              { "type": "string" }
        }
      },

      "RecordPaymentRequest": {
        "type": "object",
        "required": ["amount"],
        "properties": {
          "amount":    { "type": "number", "minimum": 0.01 },
          "method":    { "type": "string", "enum": ["CASH","CARD","BANK_TRANSFER","CHEQUE","ONLINE","OTHER"], "default": "CASH" },
          "reference": { "type": "string", "description": "Bank ref, transaction ID, cheque number, etc." },
          "note":      { "type": "string" }
        }
      },

      "InvoiceResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {
            "type": "object",
            "properties": {
              "id":             { "type": "string", "format": "uuid" },
              "invoiceNumber":  { "type": "string", "example": "INV-202407-00001" },
              "status":         { "type": "string", "enum": ["UNPAID","PAID","PARTIALLY_PAID","OVERDUE","CANCELLED"] },
              "subtotal":       { "type": "number" },
              "taxRate":        { "type": "number" },
              "taxAmount":      { "type": "number" },
              "discountRate":   { "type": "number" },
              "discountAmount": { "type": "number" },
              "totalAmount":    { "type": "number" },
              "dueDate":        { "type": "string", "format": "date-time" },
              "createdAt":      { "type": "string", "format": "date-time" },
              "lineItems":      { "type": "array", "items": { "type": "object" } },
              "customer":       { "type": "object" },
              "payments":       { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      },

      "InvoiceListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data":    { "type": "array", "items": { "type": "object" } },
          "pagination": {
            "type": "object",
            "properties": {
              "total":      { "type": "integer" },
              "page":       { "type": "integer" },
              "pageSize":   { "type": "integer" },
              "totalPages": { "type": "integer" }
            }
          }
        }
      },

      "RevenueSummaryResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {
            "type": "object",
            "properties": {
              "totalRevenue":      { "type": "number", "description": "Sum of totalAmount from PAID and PARTIALLY_PAID invoices" },
              "outstandingAmount": { "type": "number", "description": "Sum of totalAmount from UNPAID and PARTIALLY_PAID invoices" },
              "dailyCollections":  { "type": "number", "description": "Sum of payments recorded today" }
            }
          }
        }
      },

      "ForecastResponse": {
        "type": "object",
        "properties": {
          "success":     { "type": "boolean" },
          "period":      { "type": "integer", "description": "Number of forecast days requested" },
          "lookback":    { "type": "integer", "description": "Historical days used" },
          "smaWindow":   { "type": "integer", "description": "SMA window size in days" },
          "generatedAt": { "type": "string", "format": "date-time" },
          "forecast": {
            "type": "array",
            "description": "Future daily projections",
            "items": {
              "type": "object",
              "properties": {
                "date":                  { "type": "string", "format": "date", "example": "2026-08-01" },
                "predictedSales":        { "type": "number", "example": 1234.56 },
                "forecastRevenue":       { "type": "number", "example": 1234.56, "deprecated": true },
                "forecastTransactions":  { "type": "integer", "example": 12 }
              }
            }
          },
          "historical": {
            "type": "array",
            "description": "Historical daily actuals used as the SMA seed",
            "items": {
              "type": "object",
              "properties": {
                "date":         { "type": "string", "format": "date" },
                "revenue":      { "type": "number" },
                "transactions": { "type": "integer" }
              }
            }
          }
        }
      }
    }
  }
}
