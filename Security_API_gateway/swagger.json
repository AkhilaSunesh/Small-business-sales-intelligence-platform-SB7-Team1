{
  "openapi": "3.0.3",
  "info": {
    "title": "Security API Gateway",
    "version": "1.0.0",
    "description": "Gateway for auth, RBAC, inventory CRUD, and sales upload"
  },
  "servers": [
    {
      "url": "http://localhost:6000",
      "description": "Local gateway"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Register user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" },
                  "roleId": { "type": "integer", "enum": [1,2,3,4] }
                },
                "required": ["name","email","password","roleId"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User registered successfully" },
          "400": { "description": "Validation failed" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                },
                "required": ["email","password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "400": { "description": "Validation failed" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "summary": "Refresh access token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": { "type": "string" }
                },
                "required": ["refreshToken"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Access token refreshed" },
          "400": { "description": "Validation failed" },
          "403": { "description": "Invalid refresh token" }
        }
      }
    },
    "/api/inventory": {
      "get": {
        "summary": "List inventory",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Inventory retrieved" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/inventory/add": {
      "post": {
        "summary": "Add inventory stock",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productCode": { "type": "string" },
                  "quantity": { "type": "integer" }
                },
                "required": ["productCode","quantity"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Inventory updated" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/inventory/update": {
      "put": {
        "summary": "Update inventory stock",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productCode": { "type": "string" },
                  "quantity": { "type": "integer" }
                },
                "required": ["productCode","quantity"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Inventory updated" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/sales/upload": {
      "post": {
        "summary": "Upload sales CSV",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Sales uploaded" },
          "400": { "description": "CSV file required" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    }
  ,
    "/health": {
      "get": {
        "summary": "Health Check",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Security API is healthy"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}

