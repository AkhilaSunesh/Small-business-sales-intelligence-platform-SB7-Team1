{
  "openapi": "3.0.3",
  "info": {
    "title": "MarketMind AI — Security API Gateway",
    "version": "1.0.0",
    "description": "Unified gateway: authentication, RBAC, rate-limiting, audit logging, and reverse-proxy to the Backend service.\n\nAll protected routes require `Authorization: Bearer <accessToken>`.\n\nTokens are issued by `POST /api/auth/login` (access: 1 h) and refreshed via `POST /api/auth/refresh` (refresh: 7 d)."
  },
  "servers": [
    { "url": "http://localhost:7000", "description": "Local Security API Gateway" }
  ],
  "tags": [
    { "name": "Auth",          "description": "Register, login, refresh, logout, current-user" },
    { "name": "Inventory",     "description": "Stock management (proxied to backend)" },
    { "name": "Sales",         "description": "Sales transactions and CSV upload (proxied to backend)" },
    { "name": "Dashboard",     "description": "KPI summary (proxied to backend)" },
    { "name": "Analytics",     "description": "Revenue and top-product analytics (proxied to backend)" },
    { "name": "Forecast",      "description": "Sales forecast from historical data (proxied to backend)" },
    { "name": "Products",      "description": "Product catalogue (proxied to backend)" },
    { "name": "Customers",     "description": "Customer list (proxied to backend)" },
    { "name": "Notifications", "description": "Low-stock and overdue-invoice alerts — Milestone 3" },
    { "name": "AuditSummary",  "description": "Security audit log summary — Milestone 3" },
    { "name": "AI",            "description": "AI insight services — customer segmentation, churn, recommendations, anomaly detection" }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user",
        "description": "Creates a new user account. Password is bcrypt-hashed (10 rounds). Rate-limited to 10 requests per 15 min per IP.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" },
              "example": { "name": "Alice Owner", "email": "alice@marketmind.dev", "password": "Password1!", "roleId": 1 }
            }
          }
        },
        "responses": {
          "201": { "description": "User registered successfully", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterResponse" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "409": { "description": "Email already registered" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login and obtain JWT tokens",
        "description": "Validates credentials and issues a short-lived access token (1 h) and a long-lived refresh token (7 d). Rate-limited to 10 requests per 15 min per IP. Login failures are recorded in the audit log.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": { "email": "alice@marketmind.dev", "password": "Password1!" }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "description": "Invalid credentials" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh access token",
        "description": "Issues a new access token from a valid refresh token. The refresh token itself is not rotated.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "New access token issued", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshResponse" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "403": { "description": "Invalid or expired refresh token" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get current user profile",
        "description": "Returns the authenticated user's id, name, email, roleId, and role name. Requires a valid access token.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Current user profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout (stateless)",
        "description": "Stateless logout — the server records the event in the audit log. The client is responsible for discarding its tokens.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logged out successfully" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/inventory": {
      "get": {
        "tags": ["Inventory"],
        "summary": "List all inventory with low-stock flags",
        "description": "Returns every inventory record annotated with `lowStock: boolean` and a summary count. Access audited.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Inventory list + summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InventoryListResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/inventory/low-stock": {
      "get": {
        "tags": ["Inventory"],
        "summary": "List only low-stock items",
        "description": "Returns only items whose `quantity <= lowStockThreshold`, ordered by quantity ascending. Access audited.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Low-stock items with count summary" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/inventory/add": {
      "post": {
        "tags": ["Inventory"],
        "summary": "Increment stock for a product",
        "description": "Increments the stock quantity for the given product. Requires `quantity >= 1`. Write ops rate-limited to 30 per 15 min. Access audited.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InventoryWriteRequest" } } }
        },
        "responses": {
          "200": { "description": "Stock incremented" },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "description": "Product not found" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/inventory/update": {
      "put": {
        "tags": ["Inventory"],
        "summary": "Set absolute stock level for a product",
        "description": "Sets the stock quantity to the supplied value. Requires `quantity >= 0`. Write ops rate-limited to 30 per 15 min. Access audited.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InventoryUpdateRequest" } } }
        },
        "responses": {
          "200": { "description": "Stock updated" },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "description": "Product not found" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/inventory/delete": {
      "delete": {
        "tags": ["Inventory"],
        "summary": "Delete inventory record for a product",
        "description": "Removes the inventory record for the given product. Write ops rate-limited to 30 per 15 min. Access audited.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "productCode": { "type": "string", "example": "PROD-0001" } },
                "required": ["productCode"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Inventory record deleted" },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "description": "Product not found" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/sales": {
      "get": {
        "tags": ["Sales"],
        "summary": "List sales transactions (paginated, filterable)",
        "description": "Query parameters are Joi-validated at the gateway before forwarding. All query params are optional. Access audited.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page",       "in": "query", "schema": { "type": "integer", "default": 1,  "minimum": 1 },          "description": "Page number (1-based)" },
          { "name": "pageSize",   "in": "query", "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 }, "description": "Results per page" },
          { "name": "customerId", "in": "query", "schema": { "type": "string", "format": "uuid" },                       "description": "Filter by customer UUID" },
          { "name": "productId",  "in": "query", "schema": { "type": "string", "format": "uuid" },                       "description": "Filter by product UUID" },
          { "name": "startDate",  "in": "query", "schema": { "type": "string", "format": "date", "example": "2024-01-01" }, "description": "Transactions on or after this date" },
          { "name": "endDate",    "in": "query", "schema": { "type": "string", "format": "date", "example": "2024-12-31" }, "description": "Transactions on or before this date (must be >= startDate)" }
        ],
        "responses": {
          "200": { "description": "Paginated list with pagination meta", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SalesListResponse" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/sales/{id}": {
      "get": {
        "tags": ["Sales"],
        "summary": "Get a single sale by ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "Sale transaction UUID" }
        ],
        "responses": {
          "200": { "description": "Single sale transaction with customer/product/user details" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "description": "Sale not found" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/sales/upload": {
      "post": {
        "tags": ["Sales"],
        "summary": "Upload a CSV file of sales rows",
        "description": "Accepts a `.csv` file (max 10 MB). Required columns: CustomerID, ProductID, Quantity, Price, TransactionDate. Rate-limited to 5 uploads per 15 min. Upload action audited.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary", "description": "CSV file with sales rows" }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Upload summary (filename, uploadedAt, recordsInserted, duplicatesRemoved, invalidRows, validationErrors)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadSummaryResponse" } } } },
          "400": { "description": "No file, wrong format, or all rows invalid" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/dashboard/summary": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "KPI summary",
        "description": "Returns totalCustomers, totalProducts, totalSales, totalRevenue.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Dashboard KPI object" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/analytics/summary": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Analytics summary — revenue, sales count, top-5 products",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Analytics summary object" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/forecast": {
      "get": {
        "tags": ["Forecast"],
        "summary": "Sales forecast from historical transaction data",
        "description": "Generates a day-by-day sales forecast using a 7-day simple moving average over historical SalesTransaction records already in the database. No external ML library required.\n\nAccess: Roles 1 (Business Owner), 2 (Store Manager), 4 (System Administrator).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 30, "minimum": 1, "maximum": 365 },
            "description": "Number of future days to forecast (default 30)"
          },
          {
            "name": "lookback",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 90, "minimum": 7, "maximum": 365 },
            "description": "Historical days to base the SMA on (default 90)"
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 7, "minimum": 2, "maximum": 30 },
            "description": "SMA window size in days (default 7)"
          }
        ],
        "responses": {
          "200": {
            "description": "Forecast data with historical actuals",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GW_ForecastResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "description": "Forecast generation failed" }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": ["Products"],
        "summary": "List all products",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Array of products" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/customers": {
      "get": {
        "tags": ["Customers"],
        "summary": "List customers (up to 100, alphabetical)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Array of customers" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    }
  ,
    "/health": {
      "get": {
        "summary": "Health Check",
        "tags": ["Health"],
        "responses": {
          "200": { "description": "Security API is healthy" }
        }
      }
    },

    "/api/notifications": {
      "get": {
        "tags": ["Notifications"],
        "summary": "Get combined low-stock and overdue-invoice alerts",
        "description": "Returns paginated notifications from existing Inventory and Invoice data. Supports ?type=LOW_STOCK|OVERDUE_INVOICE filter.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page",  "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } },
          { "name": "type",  "in": "query", "schema": { "type": "string", "enum": ["LOW_STOCK", "OVERDUE_INVOICE"] }, "description": "Filter by notification type (optional)" }
        ],
        "responses": {
          "200": { "description": "Notification list with summary and pagination" },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/notifications/counts": {
      "get": {
        "tags": ["Notifications"],
        "summary": "Get notification badge counts",
        "description": "Lightweight endpoint returning only counts for header badge display.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Counts: total, lowStock, overdueInvoices, critical" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/notifications/low-stock": {
      "get": {
        "tags": ["Notifications"],
        "summary": "Low-stock alerts only",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page",  "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Low-stock inventory alerts" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/notifications/overdue-invoices": {
      "get": {
        "tags": ["Notifications"],
        "summary": "Overdue invoice alerts only",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page",  "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Overdue invoice alerts" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/audit-summary": {
      "get": {
        "tags": ["AuditSummary"],
        "summary": "Security audit log summary",
        "description": "Reads logs/audit.log and returns event counts per type and per user, plus recent log entries. Access: Roles 1, 2, 4 only.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50, "maximum": 500 }, "description": "Number of recent entries to return" }
        ],
        "responses": {
          "200": { "description": "Audit summary with eventCounts, userCounts, recentEntries, dateRange" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/invoices/bulk": {
      "patch": {
        "tags": ["Invoices"],
        "summary": "Bulk update invoice status — Milestone 3",
        "description": "Mark multiple invoices as PAID, UNPAID, CANCELLED, etc. in a single request. Max 100 IDs.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ids", "status"],
                "properties": {
                  "ids":    { "type": "array", "items": { "type": "string", "format": "uuid" }, "minItems": 1, "maxItems": 100 },
                  "status": { "type": "string", "enum": ["PAID","UNPAID","PARTIALLY_PAID","OVERDUE","CANCELLED"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Number of invoices updated" },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "description": "One or more invoice IDs not found" }
        }
      }
    },
    "/api/inventory/bulk": {
      "patch": {
        "tags": ["Inventory"],
        "summary": "Bulk update inventory quantities — Milestone 3",
        "description": "Set stock levels for multiple products in a single request. Max 100 updates.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["updates"],
                "properties": {
                  "updates": {
                    "type": "array",
                    "minItems": 1, "maxItems": 100,
                    "items": {
                      "type": "object",
                      "required": ["productCode", "quantity"],
                      "properties": {
                        "productCode": { "type": "string" },
                        "quantity":    { "type": "integer", "minimum": 0 }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Number of inventory records updated" },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "description": "One or more product codes not found" }
        }
      }
    },

    "/api/customer-groups": {
      "get": {
        "tags": ["AI"],
        "summary": "Customer segmentation — group all customers",
        "description": "Proxied to the Customer Segmentation AI service (port 5010). Returns customer groups. Returns 503 if the AI service is offline.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Customer group data" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "description": "AI service unavailable" }
        }
      }
    },
    "/api/churn": {
      "get": {
        "tags": ["AI"],
        "summary": "Churn risk summary",
        "description": "Proxied to the Churn Prediction AI service (port 5011). Returns churn risk distribution. Returns 503 if the AI service is offline.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Churn risk data" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "description": "AI service unavailable" }
        }
      }
    },
    "/api/recommendations": {
      "get": {
        "tags": ["AI"],
        "summary": "Product recommendations",
        "description": "Proxied to the Recommendations AI service (port 5012). Returns product recommendations. Returns 503 if the AI service is offline.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "productId", "in": "query", "schema": { "type": "string" }, "description": "Optional product ID to get recommendations for" }
        ],
        "responses": {
          "200": { "description": "Recommendation data" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "description": "AI service unavailable" }
        }
      }
    },
    "/api/anomaly-detection": {
      "get": {
        "tags": ["AI"],
        "summary": "Anomaly detection results",
        "description": "Proxied to the Anomaly Detection AI service (port 5013). Returns detected anomalous transactions. Returns 503 if the AI service is offline.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 }, "description": "Maximum anomalies to return" }
        ],
        "responses": {
          "200": { "description": "Anomaly detection data" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "description": "AI service unavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token issued by POST /api/auth/login. Expires in 1 hour."
      }
    },
    "responses": {
      "Unauthorized":    { "description": "Missing or invalid/expired JWT" },
      "Forbidden":       { "description": "Valid JWT but role lacks permission for this resource/method" },
      "ValidationError": { "description": "Joi validation failed — see errors array" },
      "RateLimited":     { "description": "Too many requests — retry after the window resets" }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["name", "email", "password", "roleId"],
        "properties": {
          "name":     { "type": "string",  "maxLength": 100 },
          "email":    { "type": "string",  "format": "email" },
          "password": { "type": "string",  "minLength": 6 },
          "roleId":   { "type": "integer", "enum": [1, 2, 3, 4], "description": "1=Business Owner, 2=Store Manager, 3=Sales Executive, 4=System Administrator" }
        }
      },
      "RegisterResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "user": {
            "type": "object",
            "properties": {
              "id":     { "type": "string", "format": "uuid" },
              "name":   { "type": "string" },
              "email":  { "type": "string" },
              "roleId": { "type": "integer" }
            }
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email":    { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success":      { "type": "boolean" },
          "message":      { "type": "string" },
          "accessToken":  { "type": "string", "description": "JWT, expires in 1 h" },
          "refreshToken": { "type": "string", "description": "JWT, expires in 7 d" },
          "user": {
            "type": "object",
            "properties": {
              "id":     { "type": "string" },
              "name":   { "type": "string" },
              "email":  { "type": "string" },
              "roleId": { "type": "integer" }
            }
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": { "type": "string" }
        }
      },
      "RefreshResponse": {
        "type": "object",
        "properties": {
          "success":     { "type": "boolean" },
          "accessToken": { "type": "string" }
        }
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "user": {
            "type": "object",
            "properties": {
              "id":     { "type": "string" },
              "name":   { "type": "string" },
              "email":  { "type": "string" },
              "roleId": { "type": "integer" },
              "role":   { "type": "object", "properties": { "name": { "type": "string" } } }
            }
          }
        }
      },
      "InventoryWriteRequest": {
        "type": "object",
        "required": ["productCode", "quantity"],
        "properties": {
          "productCode": { "type": "string",  "example": "PROD-0001" },
          "quantity":    { "type": "integer", "minimum": 1, "example": 10 }
        }
      },
      "InventoryUpdateRequest": {
        "type": "object",
        "required": ["productCode", "quantity"],
        "properties": {
          "productCode": { "type": "string",  "example": "PROD-0001" },
          "quantity":    { "type": "integer", "minimum": 0, "example": 50 }
        }
      },
      "InventoryListResponse": {
        "type": "object",
        "properties": {
          "success":   { "type": "boolean" },
          "inventory": { "type": "array", "items": { "type": "object" } },
          "summary": {
            "type": "object",
            "properties": {
              "total":         { "type": "integer" },
              "lowStockCount": { "type": "integer" }
            }
          }
        }
      },
      "SalesListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data":    { "type": "array", "items": { "type": "object" } },
          "pagination": {
            "type": "object",
            "properties": {
              "total":      { "type": "integer" },
              "page":       { "type": "integer" },
              "pageSize":   { "type": "integer" },
              "totalPages": { "type": "integer" }
            }
          }
        }
      },
      "UploadSummaryResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "summary": {
            "type": "object",
            "properties": {
              "filename":          { "type": "string" },
              "uploadedAt":        { "type": "string", "format": "date-time" },
              "totalRowsRead":     { "type": "integer" },
              "recordsInserted":   { "type": "integer" },
              "duplicatesRemoved": { "type": "integer" },
              "invalidRows":       { "type": "integer" },
              "validationErrors":  {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "row":    { "type": "integer" },
                    "reason": { "type": "string" },
                    "data":   { "type": "object" }
                  }
                }
              }
            }
          }
        }
      },

      "GW_ForecastResponse": {
        "type": "object",
        "properties": {
          "success":     { "type": "boolean" },
          "period":      { "type": "integer", "description": "Number of forecast days requested" },
          "lookback":    { "type": "integer", "description": "Historical days used as SMA input" },
          "smaWindow":   { "type": "integer", "description": "Rolling average window size in days" },
          "generatedAt": { "type": "string", "format": "date-time" },
          "forecast": {
            "type": "array",
            "description": "Future daily revenue and transaction projections",
            "items": {
              "type": "object",
              "properties": {
                "date":                 { "type": "string", "format": "date", "example": "2026-08-01" },
                "predictedSales":       { "type": "number",  "example": 1234.56 },
                "forecastRevenue":      { "type": "number",  "example": 1234.56, "deprecated": true },
                "forecastTransactions": { "type": "integer", "example": 12 }
              }
            }
          },
          "historical": {
            "type": "array",
            "description": "Historical daily actuals used as the SMA seed",
            "items": {
              "type": "object",
              "properties": {
                "date":         { "type": "string", "format": "date" },
                "revenue":      { "type": "number" },
                "transactions": { "type": "integer" }
              }
            }
          }
        }
      }
    }
  }
}

