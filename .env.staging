# Staging environment overrides
NODE_ENV=staging
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/marketmind_db?schema=public
JWT_SECRET=replace-with-staging-secret
JWT_EXPIRES_IN=7d
VITE_API_BASE_URL=http://localhost:5000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marketmind_db
POSTGRES_PORT=5432
BACKEND_PORT=5000
FRONTEND_PORT=3000
AI_SERVICE_PORT=5001
LOG_LEVEL=info
